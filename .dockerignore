# Start with an empty context; include only inputs needed to build the image.
**
!Dockerfile
!pyproject.toml
!uv.lock
!README.md
!summon/
!summon/**

# Defense in depth for local files within the allowed source directories.
**/.env
**/.env.*
**/*.session
**/*.session-journal
**/*.db
**/*.sqlite*
**/*.log
**/*.pem
**/*.key
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/node_modules
**/dist
**/coverage
