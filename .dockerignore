# Start with an empty context; include only inputs needed to build the image.
**
!Dockerfile
!pyproject.toml
!uv.lock
!README.md
!summon/
!summon/**
!web/
!web/package.json
!web/package-lock.json
!web/index.html
!web/tsconfig.json
!web/vite.config.ts
!web/src/
!web/src/**
!web/public/
!web/public/**
!web/tests/
!web/tests/**

# Defense in depth for local files within the allowed source directories.
**/.env
**/.env.*
**/*.session
**/*.session-journal
**/*.db
**/*.sqlite*
**/*.log
**/*.pem
**/*.key
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/node_modules
**/dist
**/coverage
