# Copy to .env; never commit credentials. Production requires HTTPS.
SUMMON_ENVIRONMENT=development
SUMMON_BOT_TOKEN=
SUMMON_SESSION_SECRET=
# Use the same values and synchronized clocks on every API worker.
SUMMON_SESSION_MAX_AGE=3600
SUMMON_INIT_DATA_MAX_AGE=3600
SUMMON_MONGO_URI=
SUMMON_MONGO_DATABASE=summon
# Seconds without a successful Telegram getUpdates before the bot exits for restart.
# The process manager must restart it; this does not coordinate multiple pollers.
SUMMON_POLL_WATCHDOG_SECONDS=300
# Optional path to ONLY the built public Mini App files (web/dist); empty disables serving.
SUMMON_WEB_DIST=
# Required in production: a public HTTPS URL without credentials, query or fragment.
SUMMON_WEBAPP_URL=
# Optional outbound-only Wzgram/Richgram integration; bot updates stay in aiogram.
SUMMON_TELEGRAM_API_ID=
SUMMON_TELEGRAM_API_HASH=
SUMMON_RICH_ENABLED=false
# Native Bot API rich messages need no MTProto credentials; definite rejections fall back.
SUMMON_BOT_API_RICH_ENABLED=true
# Custom emoji depend on Telegram account/pack eligibility. False uses Unicode instead.
SUMMON_PREMIUM_EMOJI_ENABLED=true
# Optional exact browser-serialized origins; use lowercase/punycode and omit default ports.
# Cross-origin deployments need additional cookie/frontend work; same-origin is recommended.
SUMMON_ALLOWED_ORIGINS=[]
# Telegram IDs of trusted catalog operators, used only on the server.
SUMMON_OPERATOR_IDS=[]
# Preview is an explicitly read-only development demonstration, never production.
SUMMON_PREVIEW_MODE=false
