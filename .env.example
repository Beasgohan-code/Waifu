# Copy to .env and fill in your own values; never commit credentials.
# These short names are aliases for the existing SUMMON_* settings. Names are
# case-insensitive (API_HASH and API_Hash both work). Use only one spelling for
# each setting: process environment wins over .env, then SUMMON_* wins within
# the same source, including when explicitly empty.
ENVIRONMENT=development
BOT_TOKEN=
API_ID=
API_HASH=
MONGO_URL=
MONGO_DB_NAME=summon
SESSION_SECRET=
WEBAPP_URL=
# One trusted Telegram user ID, or replace this line with OPERATOR_IDS=123,456.
OWNER_ID=

# Optional: the default "mongo" stores uploaded photos in the application database.
# Set ARTWORK_BACKEND=imgbb AND IMGBB_KEY to publish new Telegram photos on ImgBB.
# This is an external, public upload; use only artwork you are allowed to publish.
ARTWORK_BACKEND=mongo
IMGBB_KEY=
# Optional negative Telegram channel ID. Only sanitized uploaded photos are copied
# there after a confirmed catalog save; the bot must be allowed to post there.
DB_CHANNEL=

# Use the same session values and synchronized clocks on every API worker.
SUMMON_SESSION_MAX_AGE=3600
SUMMON_INIT_DATA_MAX_AGE=3600
# Separate database for the Wzgram worker's credential-bearing session and peer cache.
# The bot needs read/write/index rights there; API workers need read access to peers only.
TELEGRAM_SESSION_DB=summon_telegram
# Set true only after stopping all other update consumers and removing any old
# Bot API webhook. Wzgram cannot inspect or remove that webhook itself.
WEBHOOKS_DISABLED_CONFIRMED=false
# Seconds without a successful MTProto connection check before bot restart.
# A successful RPC does not prove updates were delivered or processed.
SUMMON_POLL_WATCHDOG_SECONDS=300
# Optional protected MTProto connection observation; enable on bot and API.
SUMMON_POLLER_HEARTBEAT_ENABLED=false
# API only: separate high-entropy URL-safe monitoring secret (32–128 characters).
# Never put it in a URL, the frontend, bot worker, or logs.
SUMMON_POLLER_MONITOR_TOKEN=
SUMMON_POLLER_STATUS_MAX_AGE_SECONDS=120
# Optional path to ONLY the built public Mini App files (web/dist).
SUMMON_WEB_DIST=
# WEBAPP_URL above must use HTTPS in production, without credentials or a query.
# Wzgram rich messages fall back to standard text after a definite rejection.
RICH_ENABLED=true
# Legacy compatibility switch for rich messages; false also disables them.
SUMMON_BOT_API_RICH_ENABLED=true
# Custom emoji depend on Telegram account/pack eligibility; false uses Unicode.
PREMIUM_EMOJI_ENABLED=true
# Exact browser-serialized origins, separated by commas. Include the Vercel origin.
ALLOWED_ORIGINS=
# Vercel server-side function only: HTTPS backend origin, with no path or credentials.
SUMMON_BACKEND_ORIGIN=
# OWNER_ID / OPERATOR_IDS are server-only trusted catalog operators.
# Preview is a read-only development demonstration, never production.
SUMMON_PREVIEW_MODE=false
